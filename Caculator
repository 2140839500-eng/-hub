<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="马卡龙风格的可访问计算器，支持键盘、粘贴、复制结果和简易百分号处理。">
<title>🍬 马卡龙计算器</title>
<style>
    /* ========== 基础样式 ========== */
    :root{
        --card-bg: rgba(255,255,255,0.55);
        --shadow-1: rgba(180,160,220,0.22);
        --accent-1: #f7a8c4;
        --accent-2: #f9c8a0;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: 'Comic Sans MS', 'Chalkboard SE', 'PingFang SC', 'Microsoft YaHei', cursive, sans-serif;
        -webkit-tap-highlight-color: transparent;
    }

    body {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background: linear-gradient(160deg, #fff0f4 0%, #fff8e8 30%, #eefaf2 60%, #eef1fd 100%);
        overflow: hidden;
    }

    /* ========== 漂浮气泡 ========== */
    .bubble {
        position: fixed;
        bottom: -60px;
        border-radius: 50%;
        opacity: 0.35;
        animation: floatUp linear infinite;
        pointer-events: none;
        z-index: 0;
        filter: blur(1px);
    }

    @keyframes floatUp {
        0%   { transform: translateY(0) rotate(0deg); opacity: 0.35; }
        100% { transform: translateY(-110vh) rotate(360deg); opacity: 0; }
    }

    /* ========== 计算器主体 ========== */
    .calculator {
        position: relative;
        z-index: 1;
        width: 350px;
        background: var(--card-bg);
        backdrop-filter: blur(22px) saturate(1.3);
        -webkit-backdrop-filter: blur(22px) saturate(1.3);
        border: 2px solid rgba(255, 255, 255, 0.8);
        border-radius: 36px;
        padding: 26px 22px;
        box-shadow:
            0 24px 60px var(--shadow-1),
            0 8px 20px rgba(255, 170, 200, 0.12),
            inset 0 1px 0 rgba(255, 255, 255, 0.95);
        animation: popIn 0.6s cubic-bezier(0.68, -0.55, 0.27, 1.55);
    }

    @keyframes popIn {
        0%   { transform: scale(0.6) rotate(-3deg); opacity: 0; }
        100% { transform: scale(1) rotate(0deg); opacity: 1; }
    }

    /* ========== 标题 ========== */
    .title {
        text-align: center;
        font-size: 23px;
        font-weight: bold;
        letter-spacing: 3px;
        margin-bottom: 16px;
        background: linear-gradient(90deg, #f7a8c4, #f9c8a0, #f7dd8e, #a8dfc0, #a9c4f0, #cbb2f0, #f7a8c4);
        background-size: 300% 100%;
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: rainbowFlow 6s linear infinite;
    }

    @keyframes rainbowFlow {
        0%   { background-position: 0% 50%; }
        100% { background-position: 300% 50%; }
    }

    /* ========== 显示屏 ========== */
    .screen {
        position: relative;
        background: rgba(255, 255, 255, 0.94);
        border-radius: 22px;
        padding: 18px 20px 14px;
        margin-bottom: 20px;
        min-height: 100px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        box-shadow:
            inset 0 3px 10px rgba(150, 130, 200, 0.1),
            0 0 0 3px rgba(255, 255, 255, 0.7),
            0 0 24px rgba(250, 183, 210, 0.35);
        overflow: hidden;
    }

    .screen::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 5px;
        background: linear-gradient(90deg, #f7a8c4, #f9c8a0, #f7dd8e, #a8dfc0, #a9c4f0, #cbb2f0);
        border-radius: 22px 22px 0 0;
    }

    .history {
        font-size: 15px;
        color: #bcb3ce;
        min-height: 20px;
        word-wrap: break-word;
        margin-top: 4px;
    }

    .display {
        font-size: 38px;
        font-weight: bold;
        color: #7d7590;
        word-wrap: break-word;
        word-break: break-all;
    }

    .display.bounce {
        animation: bounce 0.3s ease;
    }

    @keyframes bounce {
        0%   { transform: scale(1); }
        40%  { transform: scale(1.1); }
        100% { transform: scale(1); }
    }

    /* 按钮网格 */
    .buttons {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 13px;
    }

    button.btn {
        border: none;
        outline: none;
        height: 64px;
        border-radius: 20px;
        font-size: 25px;
        font-weight: bold;
        cursor: pointer;
        transition: transform 0.12s ease, box-shadow 0.12s ease, filter 0.15s;
        user-select: none;
    }

    button.btn:active {
        transform: translateY(4px) scale(0.95);
        filter: brightness(1.05) saturate(1.1);
    }

    button.btn:focus {
        outline: 3px solid rgba(120, 100, 200, 0.25);
        outline-offset: 4px;
    }

    /* 数字键样式 */
    .btn-num {
        color: #fff;
        text-shadow: 0 1px 4px rgba(0, 0, 0, 0.15);
        box-shadow: 0 5px 0 var(--shadow), 0 10px 16px rgba(160, 140, 200, 0.14);
    }

    .btn-n7 { background: linear-gradient(150deg, #fcd0e0, #f7a8c4); --shadow: #eb9fb8; }
    .btn-n8 { background: linear-gradient(150deg, #fdd9c0, #f9bd94); --shadow: #ecb18c; }
    .btn-n9 { background: linear-gradient(150deg, #faedb5, #f5da8c); --shadow: #e3ca84; }

    .btn-n4 { background: linear-gradient(150deg, #c5ead3, #98d8b4); --shadow: #8cc8a6; }
    .btn-n5 { background: linear-gradient(150deg, #bdeae2, #8dd9cd); --shadow: #81c6bb; }
    .btn-n6 { background: linear-gradient(150deg, #c4e0f7, #93c9ee); --shadow: #87b9dc; }

    .btn-n1 { background: linear-gradient(150deg, #c6cdf5, #9aa6ec); --shadow: #8c97d6; }
    .btn-n2 { background: linear-gradient(150deg, #dccdf3, #bd9fe8); --shadow: #ab8ed2; }
    .btn-n3 { background: linear-gradient(150deg, #f7cbe4, #eaa4cd); --shadow: #d694ba; }

    .btn-zero {
        background: linear-gradient(90deg, #fcd0e0, #fdd9c0, #faedb5, #c5ead3, #c4e0f7, #dccdf3);
        color: #fff;
        grid-column: span 2;
        text-shadow: 0 1px 4px rgba(0, 0, 0, 0.15);
        box-shadow: 0 5px 0 #cfc4e0, 0 10px 16px rgba(160, 140, 200, 0.14);
    }

    /* 功能键 */
    .btn-clear, .btn-del, .btn-op, .btn-dot, .btn-equal {
        color: #fff;
        text-shadow: 0 1px 3px rgba(0, 0, 0, 0.12);
    }

    .btn-clear  { background: linear-gradient(150deg, #d8d2e6, #b8b0cc); box-shadow: 0 5px 0 #a39bb8, 0 10px 16px rgba(160, 140, 200, 0.14); }
    .btn-del    { background: linear-gradient(150deg, #f0c8ae, #e0a583); box-shadow: 0 5px 0 #c99476, 0 10px 16px rgba(200, 150, 120, 0.14); }
    .btn-op     { background: linear-gradient(150deg, #bcc4ef, #93a0e5); box-shadow: 0 5px 0 #8090cf, 0 10px 16px rgba(140, 150, 220, 0.14); }
    .btn-dot    { background: linear-gradient(150deg, #d3bce9, #b28fdd); box-shadow: 0 5px 0 #9c7cc6, 0 10px 16px rgba(170, 140, 210, 0.14); }

    .btn-equal  {
        background: linear-gradient(90deg, #f7a8c4, #f9c8a0, #f7dd8e, #a8dfc0, #a9c4f0, #cbb2f0);
        background-size: 250% 100%;
        grid-column: span 2;
        font-size: 28px;
        animation: rainbowFlow 5s linear infinite;
        box-shadow: 0 5px 0 rgba(150, 120, 190, 0.4), 0 10px 16px rgba(160, 140, 200, 0.16);
    }

    .btn:hover {
        filter: brightness(1.05) saturate(1.1);
        transform: translateY(-2px);
    }

    /* ========== 结果彩蛋表情 ========== */
    .emoji-pop {
        position: fixed;
        font-size: 42px;
        pointer-events: none;
        z-index: 99;
        animation: emojiFly 1s ease-out forwards;
    }

    @keyframes emojiFly {
        0%   { transform: translateY(0) scale(0.5) rotate(0deg); opacity: 1; }
        100% { transform: translateY(-130px) scale(1.5) rotate(25deg); opacity: 0; }
    }

    /* 响应式 */
    @media (max-width: 390px) {
        .calculator { width: 92vw; padding: 20px 16px; }
        button.btn { height: 56px; font-size: 21px; }
        .display { font-size: 32px; }
    }

    /* 兼容无动画偏好 */
    @media (prefers-reduced-motion: reduce) {
        .bubble, .calculator, .btn-equal, .emoji-pop, .display.bounce { animation: none !important; transition: none !important; }
    }
</style>
</head>
<body>

<div class="calculator" role="application" aria-label="马卡龙计算器">
    <div class="title">🍬 马卡龙计算器</div>

    <div class="screen" aria-live="polite" aria-atomic="true">
        <div class="history" id="history"></div>
        <div class="display" id="display" role="status">0</div>
    </div>

    <div class="buttons">
        <button class="btn btn-clear"  data-action="clear" aria-label="清除">C</button>
        <button class="btn btn-del"    data-action="delete" aria-label="删除一个字符">⌫</button>
        <button class="btn btn-op"     data-value="%" aria-label="百分号">%</button>
        <button class="btn btn-op"     data-value="÷" aria-label="除">÷</button>

        <button class="btn btn-num btn-n7" data-value="7" aria-label="7">7</button>
        <button class="btn btn-num btn-n8" data-value="8" aria-label="8">8</button>
        <button class="btn btn-num btn-n9" data-value="9" aria-label="9">9</button>
        <button class="btn btn-op"     data-value="×" aria-label="乘">×</button>

        <button class="btn btn-num btn-n4" data-value="4" aria-label="4">4</button>
        <button class="btn btn-num btn-n5" data-value="5" aria-label="5">5</button>
        <button class="btn btn-num btn-n6" data-value="6" aria-label="6">6</button>
        <button class="btn btn-op"     data-value="−" aria-label="减">−</button>

        <button class="btn btn-num btn-n1" data-value="1" aria-label="1">1</button>
        <button class="btn btn-num btn-n2" data-value="2" aria-label="2">2</button>
        <button class="btn btn-num btn-n3" data-value="3" aria-label="3">3</button>
        <button class="btn btn-op"     data-value="+" aria-label="加">+</button>

        <button class="btn btn-zero"   data-value="0" aria-label="0">0</button>
        <button class="btn btn-dot"    data-value="." aria-label="小数点">.</button>
        <button class="btn btn-equal"  data-action="equals" aria-label="等于">=</button>
    </div>
</div>

<script>
    // ================= 状态 =================
    const displayEl = document.getElementById('display');
    const historyEl = document.getElementById('history');
    let expression = '';
    let justCalculated = false;

    // map for pretty display only
    const symbolMap = { '×': '*', '÷': '/', '−': '-', '+': '+', '.': '.' };

    // ================= 工具函数 =================
    function refreshDisplay() {
        displayEl.textContent = expression === '' ? '0' : expression;
        // bounce animation
        displayEl.classList.remove('bounce');
        void displayEl.offsetWidth;
        displayEl.classList.add('bounce');
    }

    function formatResult(num) {
        if (!isFinite(num)) return '⚠️ 除数不能为 0 哦';
        let rounded = Math.round(num * 1e10) / 1e10;
        let str = String(rounded);
        if (str.length > 12) str = rounded.toExponential(6);
        return str;
    }

    function popEmoji(x, y) {
        const emojis = ['🎉', '✨', '🌈', '💖', '🍬', '⭐', '🥳', '🧁'];
        const el = document.createElement('div');
        el.className = 'emoji-pop';
        el.textContent = emojis[Math.floor(Math.random() * emojis.length)];
        el.style.left = (x - 20) + 'px';
        el.style.top = (y - 20) + 'px';
        document.body.appendChild(el);
        setTimeout(() => el.remove(), 1000);
    }

    // normalize display operators to standard ASCII for computation
    function normalizeForEval(expr) {
        return expr
            .replace(/\u2212/g, '-') // '−' to '-'
            .replace(/×/g, '*')
            .replace(/÷/g, '/')
            .replace(/％/g, '%')     // full-width percent
            .replace(/[\u00A0\s]+/g, ''); // remove NBSP and spaces
    }

    const SAFE_EXPR_RE = /^[0-9+\-*/().%]+$/;

    function replacePercent(expr) {
        // Replace occurrences like '50%' with '(50/100)'
        // Support chained percents: 50%% -> ((50/100)/100)
        return expr.replace(/(\d+(?:\.\d+)?)(%+)/g, (m, num, pct) => {
            let res = num;
            for (let i = 0; i < pct.length; i++) res = `(${res}/100)`;
            return res;
        });
    }

    function safeEvaluate(displayExpr) {
        let expr = normalizeForEval(displayExpr);
        if (expr === '') throw new Error('Empty');
        expr = replacePercent(expr);
        if (!SAFE_EXPR_RE.test(expr)) {
            throw new Error('非法字符');
        }
        // Final evaluate in a narrow sandbox
        return Function('"use strict"; return (' + expr + ')')();
    }

    // ================= 核心逻辑 =================
    function inputValue(val) {
        // if we just calculated and user types a digit or dot, start fresh
        if (justCalculated) {
            if (/^[0-9.]$/.test(val)) {
                expression = '';
                historyEl.textContent = '';
            }
            justCalculated = false;
        }

        if (expression.length >= 60) return; // allow longer for complex expressions

        const isOperator = ['+', '−', '×', '÷', '%'].includes(val);
        const lastChar = expression.slice(-1);

        if (isOperator) {
            if (expression === '' && val !== '%') return; // don't start with operator except % doesn't start
            if (['+', '−', '×', '÷', '%'].includes(lastChar)) {
                // replace previous operator with new (except handle percent specially)
                expression = expression.slice(0, -1) + val;
            } else {
                expression += val;
            }
        } else if (val === '.') {
            const parts = expression.split(/[+−×÷%]/);
            const currentNumber = parts[parts.length - 1] || '';
            if (currentNumber.includes('.')) return;
            if (currentNumber === '') expression += '0.';
            else expression += val;
        } else {
            // prevent leading multiple zeros like 00 except when after operator
            if (lastChar === '0' && /^\d$/.test(val) &&
                (expression.length === 1 || /[+−×÷%]/.test(expression.slice(-2, -1)))) {
                expression = expression.slice(0, -1) + val;
            } else {
                expression += val;
            }
        }
        refreshDisplay();
    }

    function deleteLast() {
        justCalculated = false;
        expression = expression.slice(0, -1);
        refreshDisplay();
    }

    function clearAll() {
        expression = '';
        historyEl.textContent = '';
        justCalculated = false;
        refreshDisplay();
    }

    function calculate() {
        if (expression === '') return;

        let expr = expression;
        while (/[+−×÷]$/.test(expr)) {
            expr = expr.slice(0, -1);
        }
        if (expr === '') return;

        try {
            const value = safeEvaluate(expr);
            const output = formatResult(value);
            historyEl.textContent = expr + ' =';
            expression = output.startsWith('⚠️') ? '' : output;
            justCalculated = true;
            displayEl.textContent = output;
            displayEl.classList.remove('bounce');
            void displayEl.offsetWidth;
            displayEl.classList.add('bounce');
        } catch (err) {
            displayEl.textContent = '😵 出错了';
            expression = '';
            console.error(err);
        }
    }

    // ================= 事件绑定 =================
    document.querySelectorAll('button.btn').forEach(btn => {
        btn.addEventListener('click', e => {
            const action = btn.dataset.action;
            const value = btn.dataset.value;
            if (action === 'clear')  clearAll();
            else if (action === 'delete') deleteLast();
            else if (action === 'equals') {
                calculate();
                if (!displayEl.textContent.startsWith('⚠️') &&
                    !displayEl.textContent.startsWith('😵')) {
                    popEmoji(e.clientX, e.clientY);
                }
            }
            else if (value !== undefined) inputValue(value);
        });
    });

    // long-press delete (repeat)
    const btnDel = document.querySelector('.btn-del');
    let delInterval = null;
    if (btnDel) {
        btnDel.addEventListener('pointerdown', (e) => {
            deleteLast();
            delInterval = setInterval(deleteLast, 120);
            btnDel.setPointerCapture && btnDel.setPointerCapture(e.pointerId);
        });
        ['pointerup', 'pointercancel', 'pointerleave'].forEach(ev =>
            btnDel.addEventListener(ev, () => { clearInterval(delInterval); delInterval = null; }));
    }

    // 键盘支持
    document.addEventListener('keydown', e => {
        const key = e.key;
        if (/^[0-9]$/.test(key)) inputValue(key);
        else if (key === '.') inputValue('.');
        else if (key === '+') inputValue('+');
        else if (key === '-') inputValue('−');
        else if (key === '*') inputValue('×');
        else if (key === '/') { e.preventDefault(); inputValue('÷'); }
        else if (key === '%') inputValue('%');
        else if (key === 'Enter' || key === '=') { e.preventDefault(); calculate(); }
        else if (key === 'Backspace') { e.preventDefault(); deleteLast(); }
        else if (key === 'Escape') clearAll();
    });

    // paste support (normalize pasted expressions)
    document.addEventListener('paste', (e) => {
        const text = (e.clipboardData || window.clipboardData).getData('text');
        if (!text) return;
        const normalized = normalizeForEval(text);
        // allow only safe characters
        if (/^[0-9+\-*/().%]+$/.test(normalized)) {
            // if we just calculated and pasted a number, start fresh
            if (justCalculated) { expression = ''; historyEl.textContent = ''; justCalculated = false; }
            expression += normalized;
            refreshDisplay();
            e.preventDefault();
        }
    });

    // click result to copy
    displayEl.addEventListener('click', async () => {
        const text = displayEl.textContent;
        try {
            await navigator.clipboard.writeText(text);
            popEmoji(window.innerWidth / 2, window.innerHeight / 2);
        } catch (err) {
            // ignore copy failures silently
            console.warn('复制失败', err);
        }
    });

    // ================= 背景漂浮气泡 =================
    const bubbleColors = ['#f7a8c4', '#f9c8a0', '#f7dd8e', '#a8dfc0', '#a9c4f0', '#cbb2f0'];
    for (let i = 0; i < 14; i++) {
        const b = document.createElement('div');
        b.className = 'bubble';
        const size = 15 + Math.random() * 45;
        b.style.width = b.style.height = size + 'px';
        b.style.left = Math.random() * 100 + 'vw';
        b.style.background = bubbleColors[i % bubbleColors.length];
        b.style.animationDuration = (8 + Math.random() * 10) + 's';
        b.style.animationDelay = (Math.random() * 10) + 's';
        document.body.appendChild(b);
    }
</script>

</body>
</html>
